# Composer dependencies.
/vendor/
/web/core/
/web/autoload.php
/web/libraries/
/web/modules/contrib/
/web/profiles/contrib/
/web/themes/contrib/

# Drupal generated and local files.
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml

# Drupal scaffolding examples and generated files.
/web/sites/*/default.settings.php
/web/sites/*/default.services.yml

# DDEV runtime files.
/.ddev/.global_commands
/.ddev/.homeadditions
/.ddev/.importdb*
/.ddev/.downloads
/.ddev/db_snapshots/

# Logs, caches, and temporary files.
*.log
*.cache
*.tmp
*.swp
.DS_Store
Thumbs.db

# IDE/editor files.
/.idea/
/.vscode/
