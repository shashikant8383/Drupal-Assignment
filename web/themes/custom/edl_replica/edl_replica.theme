<?php

/**
 * @file
 * Theme hooks for the EDL replica theme.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Adjusts exposed filters for the Resource Library view.
 */
function edl_replica_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $view = $form_state->get('view');
  if (!$view || $view->id() !== 'resource_library') {
    return;
  }

  if (isset($form['search'])) {
    $form['search']['#attributes']['placeholder'] = 'Search resources';
  }

  if (isset($form['category']['#title'])) {
    $form['category']['#title'] = 'Category';
    edl_replica_select_to_checkboxes($form['category']);
  }

  if (isset($form['field_resource_category_target_id']['#title'])) {
    $form['field_resource_category_target_id']['#title'] = 'Category';
  }

  if (isset($form['resource_type']['#title'])) {
    $form['resource_type']['#title'] = 'Resource Type';
    edl_replica_select_to_checkboxes($form['resource_type']);
  }

  if (isset($form['field_resource_type_target_id']['#title'])) {
    $form['field_resource_type_target_id']['#title'] = 'Resource Type';
  }

  if (isset($form['sort_order'])) {
    $form['sort_order']['#access'] = FALSE;
  }
}

/**
 * Displays select-style exposed taxonomy filters as checkbox lists.
 */
function edl_replica_select_to_checkboxes(array &$element): void {
  if (($element['#type'] ?? '') !== 'select' || empty($element['#options'])) {
    return;
  }

  unset($element['#options']['All']);
  $element['#type'] = 'checkboxes';
  $element['#multiple'] = TRUE;
}
