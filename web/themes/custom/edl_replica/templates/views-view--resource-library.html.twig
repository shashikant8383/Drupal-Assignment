<section id="resource-librarys" class="edl-resource-header">
  <div class="edl-container">
    <h1>Resource Library</h1>
    <p>
      In this library, you can search for specific support topics and navigate to resources categorized by tools, technology and media format.
    </p>
  </div>
</section>

<section class="edl-resource-library">
  <div class="edl-container edl-resource-layout">
    {% if exposed %}
      <aside class="edl-resource-filters">
        <div class="edl-resource-filters__heading">
          <h2>Filters (0)</h2>
          <a href="/resources">Clear All</a>
        </div>
        {{ exposed }}
      </aside>
    {% endif %}

    <div class="edl-resource-main">
      {{ title_prefix }}
      {{ title_suffix }}

      <div class="edl-resource-count">
        <strong>{{ view.total_rows }}</strong> resources available
      </div>

      {% if rows %}
        {{ rows }}
      {% elseif empty %}
        {{ empty }}
      {% endif %}

      {% if pager %}
        {{ pager }}
      {% endif %}
    </div>
  </div>
</section>

<section class="edl-explore edl-resource-explore">
  <div class="edl-explore__image" style="background-image: url('/sites/default/files/edl-homepage/explore-skysong-cta.png');"></div>
  <div class="edl-explore__panel">
    <div class="edl-explore__content">
      <h2>Explore EDL</h2>
      <span class="edl-gold-rule" aria-hidden="true"></span>
      <p>Explore the ways EdPlus supports you in delivering a top-tier education online.</p>
      <div class="edl-link-grid">
        <a class="edl-link-card" href="#">
          <span>Instructional Design</span>
          <span aria-hidden="true">›</span>
        </a>
        <a class="edl-link-card" href="#">
          <span>Academic Media</span>
          <span aria-hidden="true">›</span>
        </a>
        <a class="edl-link-card" href="#">
          <span>Quality Assurance</span>
          <span aria-hidden="true">›</span>
        </a>
        <a class="edl-link-card" href="/learning-technologies">
          <span>Learning Technologies</span>
          <span aria-hidden="true">›</span>
        </a>
        <a class="edl-link-card" href="#">
          <span>Professional development and training</span>
          <span aria-hidden="true">›</span>
        </a>
        <a class="edl-link-card" href="#">
          <span>Book a studio appointment</span>
          <span aria-hidden="true">›</span>
        </a>
        <a class="edl-link-card" href="/resources">
          <span>Resource library</span>
          <span aria-hidden="true">›</span>
        </a>
        <a class="edl-link-card" href="#">
          <span>Contact us</span>
          <span aria-hidden="true">›</span>
        </a>
      </div>
    </div>
  </div>
</section>
