{% set url = paragraph.field_service_link.0.url ? paragraph.field_service_link.0.url : '#' %}
{% set title = paragraph.field_service_link.0.title ?: 'Learn more' %}
{% set image = paragraph.field_service_image.entity ? file_url(paragraph.field_service_image.entity.uri.value) : '' %}
{% set href %}{{ url }}{% endset %}

<article class="edl-card" style="background-image: url('{{ image }}');">
  <div class="edl-card__body">
    <h3 class="edl-card__title">{{ paragraph.field_service_title.value }}</h3>
    <div class="edl-card__summary">
      {{ content.field_service_body }}
      <a class="edl-button" href="{{ href|trim ?: '#' }}">{{ title }}</a>
    </div>
  </div>
</article>
